<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <h2>STUDENT<span> HUB</span></h2>

        <a href="#dashboard">🏠 Dashboard</a>
        <a href="#profile">👤 My Profile</a>
        <a href="#attendance">📊 Attendance</a>
        <a href="#marks">📝 Marks</a>
        <a href="#timetable">📅 Timetable</a>
        <a href="#subjects">📚 Subjects</a>
        <a href="#notifications">🔔 Notifications</a>
    </div>

    <!-- Main Content -->
    <main class="main-content" id="dashboard">

        <!-- Header -->
        <header>
            <div>
                <h1>Student Dashboard</h1>
                <p>Welcome back! Here's your academic overview.</p>
            </div>
            <div class="student-name">
                👤 Student
            </div>
        </header>

        <!-- Profile -->
        <section class="profile" id="profile">
            <div>
                <h2>Student Profile</h2>
                <p><b>Name:</b> Rahul Kumar</p>
                <p><b>Roll Number:</b> 23CS101</p>
                <p><b>Department:</b> Computer Science</p>
                <p><b>Year:</b> Second Year</p>
            </div>
        </section>

        <!-- Statistics -->
        <section class="stats">

            <div class="stat-card">
                <h3>Attendance</h3>
                <h2>85%</h2>
                <p>Overall Attendance</p>
            </div>

            <div class="stat-card">
                <h3>Average Marks</h3>
                <h2>88%</h2>
                <p>Academic Performance</p>
            </div>

            <div class="stat-card">
                <h3>Subjects</h3>
                <h2>6</h2>
                <p>Current Semester</p>
            </div>

            <div class="stat-card">
                <h3>Assignments</h3>
                <h2>4</h2>
                <p>Pending Assignments</p>
            </div>

        </section>

        <!-- Attendance -->
        <section class="content-box" id="attendance">
            <h2>Attendance Details</h2>

            <div class="attendance-item">
                <span>Mathematics</span>
                <span>90%</span>
                <div class="progress">
                    <div style="width:90%"></div>
                </div>
            </div>

            <div class="attendance-item">
                <span>Python Programming</span>
                <span>85%</span>
                <div class="progress">
                    <div style="width:85%"></div>
                </div>
            </div>

            <div class="attendance-item">
                <span>Physics</span>
                <span>80%</span>
                <div class="progress">
                    <div style="width:80%"></div>
                </div>
            </div>
        </section>

        <!-- Marks -->
        <section class="content-box" id="marks">
            <h2>Academic Marks</h2>

            <table>
                <tr>
                    <th>Subject</th>
                    <th>Marks</th>
                    <th>Grade</th>
                </tr>

                <tr>
                    <td>Mathematics</td>
                    <td>92</td>
                    <td>A+</td>
                </tr>

                <tr>
                    <td>Python</td>
                    <td>88</td>
                    <td>A</td>
                </tr>

                <tr>
                    <td>Physics</td>
                    <td>85</td>
                    <td>A</td>
                </tr>

                <tr>
                    <td>English</td>
                    <td>90</td>
                    <td>A+</td>
                </tr>
            </table>
        </section>

        <!-- Timetable -->
        <section class="content-box" id="timetable">
            <h2>Weekly Timetable</h2>

            <table>
                <tr>
                    <th>Day</th>
                    <th>9 AM</th>
                    <th>10 AM</th>
                    <th>11 AM</th>
                    <th>12 PM</th>
                </tr>

                <tr>
                    <td>Monday</td>
                    <td>Maths</td>
                    <td>Python</td>
                    <td>Physics</td>
                    <td>English</td>
                </tr>

                <tr>
                    <td>Tuesday</td>
                    <td>Python</td>
                    <td>Maths</td>
                    <td>English</td>
                    <td>Physics</td>
                </tr>

                <tr>
                    <td>Wednesday</td>
                    <td>Physics</td>
                    <td>Python</td>
                    <td>Maths</td>
                    <td>English</td>
                </tr>

                <tr>
                    <td>Thursday</td>
                    <td>English</td>
                    <td>Physics</td>
                    <td>Python</td>
                    <td>Maths</td>
                </tr>
            </table>
        </section>

        <!-- Subjects -->
        <section class="content-box" id="subjects">
            <h2>My Subjects</h2>

            <div class="subject-list">
                <div>📘 Mathematics</div>
                <div>💻 Python Programming</div>
                <div>🔬 Physics</div>
                <div>📗 English</div>
                <div>🌐 Web Development</div>
                <div>⚙️ Engineering</div>
            </div>
        </section>

        <!-- Notifications -->
        <section class="content-box" id="notifications">
            <h2>Notifications & Announcements</h2>

            <div class="notice">
                📢 Internal examination starts next Monday.
            </div>

            <div class="notice">
                📢 Submit your Python assignment before Friday.
            </div>

            <div class="notice">
                📢 College cultural fest registration is open.
            </div>
        </section>

        <!-- Footer -->
        <footer>
            <p>© 2026 Student Hub | All Rights Reserved</p>
        </footer>

    </main>

</body>
</html>
