/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f2f5fa;
    color: #333;
    display: flex;
}

/* Sidebar */
.sidebar {
    width: 240px;
    height: 100vh;
    background: #172554;
    color: white;
    padding: 25px 15px;
    position: fixed;
    left: 0;
    top: 0;
}

.sidebar h2 {
    font-size: 22px;
    margin-bottom: 35px;
    text-align: center;
}

.sidebar h2 span {
    color: #38bdf8;
}

.sidebar a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 15px;
    margin-bottom: 8px;
    border-radius: 8px;
    transition: 0.3s;
}

.sidebar a:hover {
    background: #2563eb;
}

/* Main Content */
.main-content {
    margin-left: 240px;
    width: calc(100% - 240px);
    padding: 30px;
}

/* Header */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    gap: 15px;
}

header h1 {
    color: #172554;
    margin-bottom: 8px;
}

header p {
    color: #777;
}

.student-name {
    background: white;
    padding: 15px;
    border-radius: 10px;
    box-shadow: 0 2px 8px #ddd;
}

/* Profile */
.profile {
    background: linear-gradient(120deg, #2563eb, #38bdf8);
    color: white;
    padding: 25px;
    border-radius: 12px;
    margin-bottom: 25px;
    line-height: 2;
}

.profile h2 {
    margin-bottom: 10px;
}

/* Statistics */
.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 25px;
}

.stat-card {
    background: white;
    padding: 25px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 3px 10px #ddd;
}

.stat-card h3 {
    color: #555;
    font-size: 16px;
}

.stat-card h2 {
    color: #2563eb;
    font-size: 30px;
    margin: 15px 0;
}

.stat-card p {
    color: #888;
    font-size: 13px;
}

/* Content Boxes */
.content-box {
    background: white;
    padding: 25px;
    margin-bottom: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 10px #ddd;
}

.content-box h2 {
    color: #172554;
    margin-bottom: 20px;
}

/* Attendance */
.attendance-item {
    margin-bottom: 20px;
}

.attendance-item span {
    display: inline-block;
    margin-bottom: 8px;
}

.attendance-item span:last-of-type {
    float: right;
    color: #2563eb;
    font-weight: bold;
}

.progress {
    background: #e5e7eb;
    height: 10px;
    border-radius: 10px;
    overflow: hidden;
}

.progress div {
    background: #2563eb;
    height: 100%;
    border-radius: 10px;
}

/* Tables */
table {
    width: 100%;
    border-collapse: collapse;
}

th, td {
    padding: 14px;
    text-align: center;
    border-bottom: 1px solid #ddd;
}

th {
    background: #2563eb;
    color: white;
}

tr:hover {
    background: #eff6ff;
}

/* Subjects */
.subject-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.subject-list div {
    background: #eff6ff;
    padding: 18px;
    border-radius: 8px;
    color: #172554;
    font-weight: bold;
}

/* Notifications */
.notice {
    background: #eff6ff;
    padding: 15px;
    margin-bottom: 12px;
    border-left: 4px solid #2563eb;
    border-radius: 5px;
}

/* Footer */
footer {
    text-align: center;
    padding: 20px;
    color: #777;
}

/* Responsive Design */
@media (max-width: 1000px) {
    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .subject-list {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 650px) {
    body {
        display: block;
    }

    .sidebar {
        position: relative;
        width: 100%;
        height: auto;
    }

    .sidebar h2 {
        margin-bottom: 15px;
    }

    .sidebar a {
        display: inline-block;
        padding: 10px;
        margin: 3px;
        font-size: 13px;
    }

    .main-content {
        margin-left: 0;
        width: 100%;
        padding: 15px;
    }

    header {
        flex-direction: column;
        align-items: flex-start;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .subject-list {
        grid-template-columns: 1fr;
    }

    .content-box {
        overflow-x: auto;
    }

    table {
        min-width: 450px;
    }
}
